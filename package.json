{
  "name": "decant",
  "productName": "Decant",
  "version": "0.1.2",
  "description": "Download audio or video from YouTube, Instagram, TikTok and many other sites.",
  "main": "src/main/main.js",
  "author": "m1shko",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fetch-binaries.mjs",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "lol.decant.app",
    "productName": "Decant",
    "afterSign": "scripts/sign-mac.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "m1shko",
      "synopsis": "Download audio or video from YouTube, Instagram, TikTok and many other sites."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
